# Gradle
.gradle/
.gradle-home/
build/
!gradle/wrapper/gradle-wrapper.jar

# 运行目录（runClient / runServer 的工作目录，含存档与日志）
run/
runs/

# 第三方源码参考：BD 与 ProjectE 的完整源码树
# 不纳入本仓库 —— 它们是第三方项目（各有自己的 .git），体积大，且会让克隆变得很慢。
# 需要时按 docs/VERSIONS.md 自行 clone 到 reference/ 下即可。
reference/

# 前置模组的二进制（见 libs/README.md）
# 不重新分发第三方 jar；缺失时构建会自动回退到 CurseMaven 坐标
libs/*.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# 杂项
*.log
*.tmp
.DS_Store

# 编译产物
*.class
out/

# 本地备份（含发布 jar 与前置模组二进制，体积大且不该进仓库）
# 内容与还原步骤见 backups/README.md
backups/

# WorkBuddy 的工具状态与工作记忆（非项目产物）
.workbuddy/

# 跨工作区的本机环境速查手册（非项目产物，且含本机私有路径）
# 它可能被随手复制到任意项目目录；本仓库将来要推到 GitHub，故显式排除，
# 避免 `git add -A` 把它带进提交。副本与 SHA-256 记录在 backups/README.md。
本地开发环境参考手册.md
